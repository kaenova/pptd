pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # 13. radar (spec-style) + horizontal bar + secondary axis
  - elementId: ch-radar
    elementType: chart
    bounds: [30, 30, 440, 230]
    title: Radar
    spokeAxis: {max: 100}
    data:
      cols: [metric, productA, productB]
      rows:
        - [Design, 80, 60]
        - [Speed, 90, 75]
        - [Cost, 40, 85]
        - [Support, 70, 90]
    series:
      - type: radar
        encode: {category: metric, y: productA}
        name: Product A
        lineColor: "#5470c6"
        areaColor: "#5470c6"
      - type: radar
        encode: {category: metric, y: productB}
        name: Product B
        lineColor: "#ee6666"
        lineStyle: dash
  # 14. horizontal bar (category on y side) + dataLabels
  - elementId: ch-hbar
    elementType: chart
    bounds: [500, 30, 440, 230]
    title: Horizontal bar
    xAxis: {label: {numberFormat: "#,##0"}}
    series:
      - type: bar
        encode: {x: headcount, y: dept}
        fill: "$primary"
        dataLabels: {show: true}
    data:
      cols: [dept, headcount]
      rows:
        - [Engineering, 1200]
        - [Product, 450]
        - [Design, 300]
        - [Operations, 600]
  # 15. mixed bar + line w/ secondary axis + seriesDefaults (spec c15)
  - elementId: ch-mixed
    elementType: chart
    bounds: [280, 290, 400, 230]
    title: Bar + line (secondary axis)
    yAxis:
      - {title: Sales}
      - {title: Growth, label: {numberFormat: "0%"}}
    seriesDefaults:
      bar: {fill: "#5470c6"}
      line: {smooth: true, width: 2, lineColor: "#ee6666"}
    barWidth: 0.6
    data:
      cols: [month, sales, growth]
      rows:
        - [Jan, 120, 0.10]
        - [Feb, 150, 0.25]
        - [Mar, 180, 0.20]
    series:
      - type: bar
        encode: {x: month, y: sales}
        name: Sales
      - type: line
        encode: {x: month, y: growth}
        name: Growth rate
        yAxisIndex: 1
